# Copy to .env and fill in real values. Never commit .env.
# Precedence: config.yml < .env < real environment variables < CLI flags.
APP_ENV=development
LOG_LEVEL=INFO

# Optional overrides for config.yml (leave empty to use config.yml).
HUB_HOST=
HUB_PORT=
# Several folders are separated by ';' on Windows (':' on Linux/macOS).
# Example: HUB_LIBRARY_PATHS=E:\Movies;F:\Shows
HUB_LIBRARY_PATHS=
# Library index file (default: data/library.db in the project folder).
HUB_INDEX_PATH=
# Media tools and cache (empty = config.yml / PATH).
HUB_CACHE_DIR=
HUB_FFMPEG=
HUB_FFPROBE=
HUB_MEDIA_WORKERS=

# PIN for other devices (4-32 characters; empty = no PIN). The server computer itself never
# needs it. Changing it logs every device out.
HUB_PIN=
# Conversion of formats the browser cannot play (true/false) and how many at once.
HUB_TRANSCODE=
HUB_TRANSCODE_MAX_SESSIONS=
